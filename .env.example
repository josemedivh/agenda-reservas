# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# PostgreSQL (lo usa docker-compose.yml)
# Superusuario solo para crear la base y los roles; la aplicación no lo usa.
POSTGRES_USER=turnero
POSTGRES_PASSWORD=turnero
POSTGRES_DB=turnero
POSTGRES_PORT=5432
# Roles creados por docker/postgres/init/01-roles.sh
TURNERO_OWNER_PASSWORD=turnero_owner
TURNERO_APP_PASSWORD=turnero_app

# Conexiones de la API
# Dueño del esquema: solo para migraciones de Prisma.
MIGRATION_DATABASE_URL=postgresql://turnero_owner:turnero_owner@localhost:5432/turnero
# Rol de la aplicación: sujeto a Row Level Security.
DATABASE_URL=postgresql://turnero_app:turnero_app@localhost:5432/turnero
# Base separada para las pruebas de integración.
TEST_MIGRATION_DATABASE_URL=postgresql://turnero_owner:turnero_owner@localhost:5432/turnero_test
TEST_DATABASE_URL=postgresql://turnero_app:turnero_app@localhost:5432/turnero_test

# Redis (lo usa docker-compose.yml)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API (NestJS)
API_PORT=3001
# Origen permitido por CORS (la web); las cookies de sesión viajan con credentials.
WEB_ORIGIN=http://localhost:3000

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
