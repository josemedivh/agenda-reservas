# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# PostgreSQL (lo usa docker-compose.yml)
POSTGRES_USER=turnero
POSTGRES_PASSWORD=turnero
POSTGRES_DB=turnero
POSTGRES_PORT=5432
DATABASE_URL=postgresql://turnero:turnero@localhost:5432/turnero

# Redis (lo usa docker-compose.yml)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API (NestJS)
API_PORT=3001

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
