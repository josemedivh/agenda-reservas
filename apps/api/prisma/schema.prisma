// Tenant tables carry business_id and are protected by row level security policies
// written in SQL inside the migrations (Prisma cannot express them).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum BusinessStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("business_status")
}

enum MemberRole {
  OWNER    @map("owner")
  ADMIN    @map("admin")
  EMPLOYEE @map("employee")

  @@map("member_role")
}

model Business {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String         @unique
  // E.164, e.g. +593991234567.
  phone     String
  address   String?
  logoUrl   String?        @map("logo_url")
  timeZone  String         @map("time_zone")
  status    BusinessStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  members       Member[]
  professionals Professional[]
  services      Service[]

  @@map("businesses")
}

// Global account (not tenant scoped): one user can manage several businesses.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships   Member[]
  sessions      Session[]
  professionals Professional[]

  @@map("users")
}

// Global (not tenant scoped): sessions belong to a user, not to a business.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // SHA-256 of the cookie token; the token itself is never stored.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Member {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String     @map("business_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  role       MemberRole
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("members")
}

// Who attends the appointments. Never deleted: deactivated (active = false) instead.
model Professional {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  // Avatar color from the shared palette (#RRGGBB).
  color      String
  active     Boolean  @default(true)
  // Optional account of the professional (for a future employee login).
  userId     String?  @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  services ServiceProfessional[]

  // Target of (professional_id, business_id) references: assignments cannot cross businesses.
  @@unique([id, businessId], map: "professionals_id_business_id_key")
  @@index([businessId])
  @@map("professionals")
}

// What a business sells. Never deleted: deactivated (active = false) instead.
model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  name            String
  durationMinutes Int      @map("duration_minutes")
  // USD cents (integer). Appointments will copy name and price when booked.
  priceCents      Int      @map("price_cents")
  // Minutes blocked after the appointment (cleaning, preparation).
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  professionals ServiceProfessional[]

  @@unique([id, businessId], map: "services_id_business_id_key")
  @@index([businessId])
  @@map("services")
}

// Which professionals perform which service, always within the same business.
model ServiceProfessional {
  businessId     String @map("business_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  service      Service      @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId, businessId], references: [id, businessId], onDelete: Restrict)

  @@id([serviceId, professionalId])
  @@index([professionalId])
  @@map("service_professionals")
}
